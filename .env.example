# Contoh variabel untuk integrasi PRODUKSI Next.js + Supabase + Vercel.
# File index.html demo lokal belum membaca variabel di bawah ini.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Bootstrap admin harus dijalankan dari script server yang hanya berjalan sekali.
BOOTSTRAP_ADMIN_USERNAME=siya
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
BOOTSTRAP_ADMIN_EMAIL=sitiyasinta029@gmail.com

# Email transaksi untuk password recovery / notifikasi Hubungi Admin.
RESEND_API_KEY=re_replace_me
ADMIN_NOTIFICATION_EMAIL=sitiyasinta029@gmail.com
EMAIL_FROM=GoLearnMS <noreply@example.com>

# Pilih salah satu provider AI; gunakan server-side API route dan rate limit.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-server-side-key
GEMINI_API_KEY=replace-with-server-side-key
